{
  "schemaVersion": 1,
  "id": "acoustic-base-radar",
  "version": "${version}",
  "name": "Acoustic Base Radar",
  "description": "Meteor Client addon for clustering real received sounds into ranked potential base-activity markers.",
  "authors": ["Custom addon"],
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "dev.acousticradar.AcousticRadarAddon"
    ]
  },
  "custom": {
    "meteor-client:color": "255,160,40"
  },
  "depends": {
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabricloader": ">=0.16.5",
    "meteor-client": "*"
  }
}
